{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "daylog",
  "version": "0.1.0",
  "identifier": "dev.puwka.daylog",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "daylog",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "pause-prompt",
        "title": "daylog",
        "width": 440,
        "height": 360,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
